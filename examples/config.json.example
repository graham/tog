{
  "auth": {
    "password": {
      "enabled": true
    },
    "magic_link": {
      "enabled": true,
      "token_lifetime": 15,
      "rate_limit_secs": 30,
      "base_url": "http://localhost:8080"
    },
    "oauth": {
      "success_url": "/",
      "failure_url": "/login?error=oauth_failed",
      "google": {
        "enabled": true,
        "client_id": "${GOOGLE_CLIENT_ID}",
        "client_secret": "${GOOGLE_CLIENT_SECRET}",
        "redirect_url": "http://localhost:3000/auth/oauth/google/callback"
      }
    }
  },
  "email": {
    "resend_api_key": "${RESEND_API_KEY}",
    "from_address": "",
    "from_name": ""
  }
}
